    frameCount = frameCount + 1
    local now = tick()
    if now - lastFpsTime >= 1 then
        WmFps.Text = string.format("%d fps", math.floor(frameCount / (now - lastFpsTime)))
        frameCount = 0
        lastFpsTime = now
        WmTime.Text = os.date("%H:%M")
        
        local pingVal = 0
        pcall(function()
            pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        WmPing.Text = string.format("%dms", pingVal)
    end
end)

