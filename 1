            IconImg.ImageColor3 = Library.theme.text
            TitleLbl.TextColor3 = Library.theme.text
            Window.activeTab = Tab
            Library:chime("Click")
        end

        Tab.btn = TabBtn
        Tab.icon = IconImg
        Tab.title = TitleLbl
        TabBtn.MouseButton1Click:Connect(function() Tab:select() end)

        -- ======================================================================
        -- SECTION CONSTRUCTOR
        -- ======================================================================
        function Tab:section(scfg)
            scfg = scfg or {}
            local secName = scfg.name or "Section"
            local side = scfg.side or "left"
            local parentCol = (side:lower() == "right") and RightCol or LeftCol

            local Section = {}

            local Panel = Instance.new("Frame")
            Panel.Name = "Sec_" .. secName
            Panel.Size = UDim2.new(1, 0, 0, 36)
            Panel.BackgroundColor3 = Library.theme.panel
            Panel.BorderSizePixel = 0
            Panel.ZIndex = 14
            Panel.Parent = parentCol
            Section.panel = Panel

            local SecCorner = Instance.new("UICorner")
            SecCorner.CornerRadius = UDim.new(0, 7)
            SecCorner.Parent = Panel

            local SecStroke = Instance.new("UIStroke")
            SecStroke.Color = Library.theme.line
            SecStroke.Thickness = 1
            SecStroke.Transparency = 0.5
            SecStroke.Parent = Panel

            local SecHeader = Instance.new("TextLabel")
            SecHeader.Size = UDim2.new(1, -16, 0, 28)
            SecHeader.Position = UDim2.new(0, 10, 0, 4)
            SecHeader.BackgroundTransparency = 1
            SecHeader.Font = Enum.Font.GothamBold
            SecHeader.TextSize = 13
            SecHeader.TextColor3 = Library.theme.text
            SecHeader.TextXAlignment = Enum.TextXAlignment.Left
            SecHeader.Text = secName
            SecHeader.ZIndex = 15
            SecHeader.Parent = Panel

            local Items = Instance.new("Frame")
            Items.Name = "Items"
            Items.Size = UDim2.new(1, -16, 0, 0)
            Items.Position = UDim2.new(0, 8, 0, 32)
            Items.BackgroundTransparency = 1
            Items.ZIndex = 15
            Items.Parent = Panel
            Section.items = Items

            local SecLayout = Instance.new("UIListLayout")
            SecLayout.Padding = UDim.new(0, 6)
            SecLayout.Parent = Items

            local function updateSecSize()
                local h = SecLayout.AbsoluteContentSize.Y
                Items.Size = UDim2.new(1, -16, 0, h)
                Panel.Size = UDim2.new(1, 0, 0, h + 40)
            end
            SecLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateSecSize)

            -- WIDGET: TOGGLE
            function Section:toggle(tcfg)
                tcfg = tcfg or {}
                local togName = tcfg.name or "Toggle"
                local state = tcfg.default or false
                local callback = tcfg.callback or function() end

                local TogRow = Instance.new("TextButton")
                TogRow.Size = UDim2.new(1, 0, 0, 26)
                TogRow.BackgroundTransparency = 1
                TogRow.Text = ""
                TogRow.ZIndex = 16
                TogRow.Parent = Items

                local Box = Instance.new("Frame")
                Box.Size = UDim2.new(0, 16, 0, 16)
                Box.Position = UDim2.new(0, 0, 0.5, -8)
                Box.BackgroundColor3 = state and Library.theme.accent or Library.theme.bg
                Box.BorderSizePixel = 0
                Box.ZIndex = 17
                Box.Parent = TogRow

                local BoxCorner = Instance.new("UICorner")
                BoxCorner.CornerRadius = UDim.new(0, 4)
                BoxCorner.Parent = Box

                local BoxStroke = Instance.new("UIStroke")
                BoxStroke.Color = Library.theme.line
                BoxStroke.Thickness = 1
                BoxStroke.Parent = Box

                local Txt = Instance.new("TextLabel")
                Txt.Size = UDim2.new(1, -26, 1, 0)
                Txt.Position = UDim2.new(0, 24, 0, 0)
                Txt.BackgroundTransparency = 1
                Txt.Font = Enum.Font.GothamMedium
                Txt.TextSize = 12
                Txt.TextColor3 = state and Library.theme.text or Library.theme.dim
                Txt.TextXAlignment = Enum.TextXAlignment.Left
                Txt.Text = togName
                Txt.ZIndex = 17
                Txt.Parent = TogRow

                local elem = {on = state}
                function elem:set(val)
                    elem.on = val
                    Box.BackgroundColor3 = val and Library.theme.accent or Library.theme.bg
                    Txt.TextColor3 = val and Library.theme.text or Library.theme.dim
                    Library:chime("Click")
                    callback(val)
                end

                function elem:get() return elem.on end

                TogRow.MouseButton1Click:Connect(function()
                    elem:set(not elem.on)
                end)

                return elem
            end

            -- WIDGET: SLIDER
            function Section:slider(scfg)
                scfg = scfg or {}
                local sName = scfg.name or "Slider"
                local min = scfg.min or 0
                local max = scfg.max or 100
                local cur = scfg.default or min
                local callback = scfg.callback or function() end

                local SRow = Instance.new("Frame")
                SRow.Size = UDim2.new(1, 0, 0, 42)
                SRow.BackgroundTransparency = 1
                SRow.ZIndex = 16
                SRow.Parent = Items

                local Txt = Instance.new("TextLabel")
                Txt.Size = UDim2.new(1, -40, 0, 18)
                Txt.BackgroundTransparency = 1
                Txt.Font = Enum.Font.GothamMedium
                Txt.TextSize = 12
                Txt.TextColor3 = Library.theme.dim
                Txt.TextXAlignment = Enum.TextXAlignment.Left
                Txt.Text = sName
                Txt.ZIndex = 17
                Txt.Parent = SRow

                local ValLbl = Instance.new("TextLabel")
                ValLbl.Size = UDim2.new(0, 36, 0, 18)
                ValLbl.Position = UDim2.new(1, -36, 0, 0)
                ValLbl.BackgroundTransparency = 1
                ValLbl.Font = Enum.Font.GothamBold
                ValLbl.TextSize = 12
                ValLbl.TextColor3 = Library.theme.text
                ValLbl.TextXAlignment = Enum.TextXAlignment.Right
                ValLbl.Text = tostring(cur)
                ValLbl.ZIndex = 17
                ValLbl.Parent = SRow

                local Track = Instance.new("Frame")
                Track.Size = UDim2.new(1, 0, 0, 6)
                Track.Position = UDim2.new(0, 0, 0, 24)
                Track.BackgroundColor3 = Library.theme.bg
                Track.BorderSizePixel = 0
                Track.ZIndex = 17
                Track.Parent = SRow

                local TrackCorner = Instance.new("UICorner")
                TrackCorner.CornerRadius = UDim.new(1, 0)
                TrackCorner.Parent = Track

                local Fill = Instance.new("Frame")
                Fill.Size = UDim2.new((cur - min) / (max - min), 0, 1, 0)
                Fill.BackgroundColor3 = Library.theme.accent
                Fill.BorderSizePixel = 0
                Fill.ZIndex = 18
                Fill.Parent = Track

                local FillCorner = Instance.new("UICorner")
                FillCorner.CornerRadius = UDim.new(1, 0)
                FillCorner.Parent = Fill

                local elem = {value = cur}
                function elem:set(val)
                    val = math.clamp(val, min, max)
                    elem.value = val
                    ValLbl.Text = tostring(val)
                    Fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
                    callback(val)
                end

                function elem:get() return elem.value end

                local sliding = false
                Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        local pct = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                        elem:set(math.floor(min + (max - min) * pct + 0.5))
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        local pct = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                        elem:set(math.floor(min + (max - min) * pct + 0.5))
                    end
                end)

                return elem
            end

            -- WIDGET: BUTTON
            function Section:button(bcfg)
                bcfg = bcfg or {}
                local bName = bcfg.name or "Button"
                local callback = bcfg.callback or function() end

                local Btn = Instance.new("TextButton")
                Btn.Size = UDim2.new(1, 0, 0, 28)
                Btn.BackgroundColor3 = Library.theme.bg
                Btn.Font = Enum.Font.GothamMedium
                Btn.TextSize = 12
                Btn.TextColor3 = Library.theme.text
                Btn.Text = bName
                Btn.ZIndex = 16
                Btn.Parent = Items

                local BtnCorner = Instance.new("UICorner")
                BtnCorner.CornerRadius = UDim.new(0, 6)
                BtnCorner.Parent = Btn

                local BtnStroke = Instance.new("UIStroke")
                BtnStroke.Color = Library.theme.line
                BtnStroke.Thickness = 1
                BtnStroke.Parent = Btn

                Btn.MouseButton1Click:Connect(function()
                    Library:chime("Click")
                    callback()
                end)

                return Btn
            end

            -- WIDGET: DROPDOWN
            function Section:dropdown(dcfg)
                dcfg = dcfg or {}
                local dName = dcfg.name or "Dropdown"
                local opts = dcfg.options or {}
                local cur = dcfg.default or opts[1] or ""
                local callback = dcfg.callback or function() end

                local DRow = Instance.new("Frame")
                DRow.Size = UDim2.new(1, 0, 0, 48)
                DRow.BackgroundTransparency = 1
                DRow.ZIndex = 16
                DRow.Parent = Items

                local Txt = Instance.new("TextLabel")
                Txt.Size = UDim2.new(1, 0, 0, 18)
                Txt.BackgroundTransparency = 1
                Txt.Font = Enum.Font.GothamMedium
                Txt.TextSize = 12
                Txt.TextColor3 = Library.theme.dim
                Txt.TextXAlignment = Enum.TextXAlignment.Left
                Txt.Text = dName
                Txt.ZIndex = 17
                Txt.Parent = DRow

                local DBtn = Instance.new("TextButton")
                DBtn.Size = UDim2.new(1, 0, 0, 24)
                DBtn.Position = UDim2.new(0, 0, 0, 20)
                DBtn.BackgroundColor3 = Library.theme.bg
                DBtn.Font = Enum.Font.GothamMedium
                DBtn.TextSize = 12
                DBtn.TextColor3 = Library.theme.text
                DBtn.Text = "  " .. tostring(cur)
                DBtn.TextXAlignment = Enum.TextXAlignment.Left
                DBtn.ZIndex = 17
                DBtn.Parent = DRow

                local DCorner = Instance.new("UICorner")
                DCorner.CornerRadius = UDim.new(0, 6)
                DCorner.Parent = DBtn

                local DStroke = Instance.new("UIStroke")
                DStroke.Color = Library.theme.line
                DStroke.Thickness = 1
                DStroke.Parent = DBtn

                local elem = {value = cur}
                function elem:set(val)
                    elem.value = val
                    DBtn.Text = "  " .. tostring(val)
                    callback(val)
                end
                function elem:get() return elem.value end

                return elem
            end

            return Section
        end

        -- Sub-Tabs creator
        function Tab:sub(subcfg)
            SubBar.Visible = true
            subcfg = subcfg or {}
            local subName = subcfg.name or "Sub"

            local SubBtn = Instance.new("TextButton")
            SubBtn.Size = UDim2.new(0, 72, 1, 0)
            SubBtn.BackgroundColor3 = Library.theme.panel
            SubBtn.Text = subName
            SubBtn.Font = Enum.Font.GothamBold
            SubBtn.TextSize = 11
            SubBtn.TextColor3 = Library.theme.dim
            SubBtn.ZIndex = 14
            SubBtn.Parent = SubBar

            local SCorner = Instance.new("UICorner")
            SCorner.CornerRadius = UDim.new(0, 5)
            SCorner.Parent = SubBtn

            local subObj = {name = subName}
            function subObj:section(scfg)
                return Tab:section(scfg)
            end

            return subObj
        end

        table.insert(Window.tabs, Tab)
        if #Window.tabs == 1 then
            Tab:select()
        end

        return Tab
    end

    table.insert(Library.wins, Window)
    return Window
end

return Library
