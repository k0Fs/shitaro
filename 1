-- Audio player
function Library:chime(t)
    if not self.sound then return end
    local toneId = self.tones[self.tone] or self.tones["Click"]
    local s = Instance.new("Sound")
    s.SoundId = toneId
    s.Volume = 0.35
    s.Parent = ScreenGui
    s:Play()
    s.Ended:Connect(function() s:Destroy() end)
end

function Library:settone(name)
    if self.tones[name] then
        self.tone = name
    end
end

function Library:setsound(state)
    self.sound = state
end

-- Resolve Icon Asset
local function resolveIcon(name)
    if not name then return "" end
    if name:find("rbxasset") then return name end
    local id = Library.icons[name]
    if id then
        return "rbxassetid://" .. id
    end
    return "rbxassetid://" .. name
end

